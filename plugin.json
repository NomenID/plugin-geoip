{
    "name": "GeoIP",
    "version": "1.0.0",
    "description": "Country and location by IP: prefills signup country, adds location to activity logs",
    "license": "GPL-3.0-only",
    "author": [
        "Yunyun (Wang Yaoze)"
    ],
    "requires": {
        "Nomen": ">=1.0"
    },
    "autoload": {
        "Nomen\\Plugin\\GeoIP\\": "src/"
    },
    "boot": [
        "Nomen\\Plugin\\GeoIP\\Plugin",
        "boot"
    ],
    "specialPages": {
        "geoip": {
            "title": "GeoIP 状态",
            "access": "admin",
            "handler": [
                "Nomen\\Plugin\\GeoIP\\SpecialGeoIP",
                "render"
            ]
        }
    },
    "homepage": "https://nomenid.org/w/plugin-geoip"
}
